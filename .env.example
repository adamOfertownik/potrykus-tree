# Environment variables (production / Vercel)

SESSION_SECRET=
COOKIE_NAME=potrykus_family_session
DATABASE_URL=
# Vercel Marketplace Neon often injects potrykus_DATABASE_URL instead.
# The app also reads: potrykus_DATABASE_URL, POSTGRES_URL, potrykus_POSTGRES_URL
# Family + admin accounts live in Neon (app_users). Create with:
# npm run db:create-user -- email@example.com haslo123 member
# npm run db:create-admin -- email@example.com haslo123
BLOB_READ_WRITE_TOKEN=

# SESSION_SECRET — min. 16 znaków, dodaj ręcznie na Vercel (Neon tego nie wstawia).
# Bez URL-a Neona zapisy zgłoszeń/RSVP padają na data/*.json (nie trzymają się na Vercel).
