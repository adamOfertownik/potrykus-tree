# Environment variables (production / Vercel)

SESSION_SECRET=
COOKIE_NAME=potrykus_family_session
DATABASE_URL=
# Family + admin accounts live in Neon (app_users). Create with:
# npm run db:create-user -- email@example.com haslo123 member
# npm run db:create-admin -- email@example.com haslo123
BLOB_READ_WRITE_TOKEN=

# SESSION_SECRET — min. 16 znaków, tylko w env (nie w git).
# DATABASE_URL — Neon pooled URL. Logowanie i zapisy wymagają Neona.
# Bez DATABASE_URL zapisy zgłoszeń/RSVP padają na data/*.json (nie trzymają się na Vercel).
