# Environment variables (production / Vercel)

# Supabase Auth (logowanie kontem rodzinnym)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admini (przecinek, małe/wielkie litery nieważne). Alternatywa: w Supabase
# User → App metadata: { "role": "admin" }
ADMIN_EMAILS=

SESSION_SECRET=
ACCESS_CODE_HASH=
COOKIE_NAME=potrykus_family_session
DATABASE_URL=
ADMIN_CODE=
BLOB_READ_WRITE_TOKEN=

# Local fallback: values from data/config.json are used when SESSION_SECRET /
# ACCESS_CODE_HASH are unset. DATABASE_URL enables Neon for submissions + RSVPs
# (npm run db:migrate). Without it, writes fall back to data/*.json (won't persist
# on Vercel).
