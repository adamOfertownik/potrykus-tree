# Environment variables (production / Vercel)

SESSION_SECRET=
ACCESS_CODE_HASH=
COOKIE_NAME=potrykus_family_session
DATABASE_URL=
# This project’s Vercel Neon integration uses:
# potrykus_DATABASE_URL
# potrykus_DATABASE_URL_UNPOOLED
# Admin accounts live in Neon (admin_users table). Create with:
# npm run db:create-admin -- email@example.com haslo123
BLOB_READ_WRITE_TOKEN=

# Local fallback: values from data/config.json are used when SESSION_SECRET /
# ACCESS_CODE_HASH are unset. DATABASE_URL or POSTGRES_URL (Vercel Neon
# marketplace) enables Neon for the family tree, submissions, RSVPs and
# admin users. Enable the variable for Production AND Preview, then Redeploy.
