# Environment variables (production / Vercel)

SESSION_SECRET=
ACCESS_CODE_HASH=
COOKIE_NAME=potrykus_family_session
DATABASE_URL=
# Admin accounts live in Neon (admin_users table). Create with:
# npm run db:create-admin -- email@example.com haslo123
BLOB_READ_WRITE_TOKEN=

# Local fallback: values from data/config.json are used when SESSION_SECRET /
# ACCESS_CODE_HASH are unset. DATABASE_URL enables Neon for the family tree,
# submissions and RSVPs (`npm run db:migrate`). Without DATABASE_URL, writes
# fall back to data/*.json (won't persist on Vercel). First Neon read copies
# data/family.json into family_tree if the table is empty.
